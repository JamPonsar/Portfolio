---
import { projects } from '../data/content';
import ChurnDemo from './demos/ChurnDemo.astro';
import DolphinDemo from './demos/DolphinDemo.astro';
import StackDemo from './demos/StackDemo.astro';
import RoboDemo from './demos/RoboDemo.astro';

// The track holds two identical groups so translating by -50% loops seamlessly.
// Each group repeats the projects so it is wider than any realistic viewport.
const COPIES_PER_GROUP = 2;
const groups = [0, 1].map((g) =>
  Array.from({ length: COPIES_PER_GROUP }, (_, c) =>
    projects.map((project, index) => ({ project, index, primary: g === 0 && c === 0 }))
  ).flat()
);
---

<section id="projects" class="section projects">
  <div class="container">
    <span class="eyebrow" data-reveal>Selected projects</span>
    <h2 class="section-title" data-reveal style="--delay: 100ms">
      Things I’ve <em>built</em>.
    </h2>
  </div>

  <div class="viewport" data-reveal style="--delay: 200ms">
    <div class="track">
      {
        groups.map((group) => (
          <div class="group">
            {group.map(({ project, index, primary }) => (
              <article
                class:list={['card', { dup: !primary }]}
                style="--card-accent: var(--accent)"
                data-index={index}
                role="button"
                tabindex={primary ? 0 : -1}
                aria-hidden={primary ? undefined : 'true'}
                aria-label={`${project.title} — view details`}
              >
                <div class="card-top">
                  <span class="period">{project.period}</span>
                  <span class="more" aria-hidden="true">
                    View <span>↗</span>
                  </span>
                </div>
                <h3>{project.title}</h3>
                <p>{project.description}</p>
                <ul class="tags">
                  {project.tags.map((tag) => (
                    <li class="tag">{tag}</li>
                  ))}
                </ul>
              </article>
            ))}
          </div>
        ))
      }
    </div>
  </div>

  <div class="xp-panel" role="dialog" aria-modal="true" aria-label="Project details" hidden>
    <div class="xp-inner">
      <div class="xp-bar">
        <span class="xp-period"></span>
        <button type="button" class="xp-close" aria-label="Close project details">
          <span>Close</span>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
            <path d="M5 5l14 14M19 5L5 19"></path>
          </svg>
        </button>
      </div>

      {
        projects.map((project, i) => (
          <div class="xp-detail" data-index={i} data-id={project.id} hidden>
            <h3>{project.title}</h3>
            <p class="xp-lead">{project.description}</p>

            <div class="xp-overview">
              {project.overview.map((para) => (
                <p>{para}</p>
              ))}
            </div>

            <h4>{project.demoTitle}</h4>
            <p class="demo-hint">{project.demoHint}</p>
            {project.id === 'churn' && <ChurnDemo />}
            {project.id === 'dolphin' && <DolphinDemo />}
            {project.id === 'stackoverflow' && <StackDemo />}
            {project.id === 'roborush' && <RoboDemo url={project.live!} />}

            <h4>Highlights</h4>
            <ul class="xp-list">
              {project.highlights.map((item) => (
                <li>{item}</li>
              ))}
            </ul>

            <h4>Built with</h4>
            <ul class="tags">
              {project.tags.map((tag) => (
                <li class="tag">{tag}</li>
              ))}
            </ul>

            <a class="xp-link" href={project.repo} target="_blank" rel="noreferrer">
              View the code on GitHub <span aria-hidden="true">↗</span>
            </a>
          </div>
        ))
      }
    </div>
  </div>
</section>

<script>
  import { createExpander } from '../scripts/expand';

  const section = document.getElementById('projects') as HTMLElement;
  const panel = section.querySelector<HTMLElement>('.xp-panel')!;
  const details = [...panel.querySelectorAll<HTMLElement>('.xp-detail')];

  const expander = createExpander({
    panel,
    onOpen(card) {
      const index = card.dataset.index;
      details.forEach((d) => (d.hidden = d.dataset.index !== index));
      const id = details.find((d) => d.dataset.index === index)?.dataset.id;
      window.dispatchEvent(new CustomEvent('project-open', { detail: { id } }));
      panel.querySelector('.xp-period')!.textContent = card.querySelector('.period')?.textContent ?? '';
      // Pause the carousel so the card is still in place when the panel closes
      section.classList.add('is-open');
    },
    onClose() {
      window.dispatchEvent(new CustomEvent('project-close'));
    },
    onClosed() {
      section.classList.remove('is-open');
    },
  });

  section.querySelectorAll<HTMLElement>('.card').forEach(expander.bind);
</script>

<style>
  .projects {
    background: var(--bg-alt);
    overflow: hidden;
  }

  /* Carousel */
  .viewport {
    margin-top: 4rem;
    padding: 1.5rem 0 2rem;
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 6%, #000 94%, transparent);
    mask-image: linear-gradient(90deg, transparent, #000 6%, #000 94%, transparent);
  }

  .track {
    display: flex;
    width: max-content;
    animation: scroll 80s linear infinite;
  }

  .viewport:hover .track,
  .projects.is-open .track,
  .viewport:focus-within .track {
    animation-play-state: paused;
  }

  .group {
    display: flex;
    gap: 1.5rem;
    padding-right: 1.5rem;
  }

  @keyframes scroll {
    to {
      transform: translateX(-50%);
    }
  }

  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    flex: none;
    width: min(82vw, 380px);
    gap: 1rem;
    padding: clamp(1.5rem, 3vw, 2.25rem);
    border-radius: 24px;
    background: var(--surface);
    border: 1px solid var(--line);
    overflow: hidden;
    isolation: isolate;
    cursor: pointer;
    transition:
      transform 0.6s var(--ease),
      box-shadow 0.6s var(--ease),
      color 0.5s ease;
  }

  .card:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 4px;
  }

  .card::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: var(--card-accent);
    clip-path: circle(0% at 100% 0%);
    transition: clip-path 0.8s var(--ease);
  }

  .card:hover {
    transform: translateY(-6px);
    box-shadow: 0 30px 60px -30px rgba(28, 26, 23, 0.45);
  }

  .card:hover,
  .xp-ghost {
    color: var(--surface);
  }

  .card:hover::before,
  .xp-ghost::before {
    clip-path: circle(150% at 100% 0%);
  }

  .card-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 0.85rem;
    font-weight: 600;
  }

  .period,
  .more {
    color: var(--ink-muted);
    transition: color 0.5s ease;
  }

  .more {
    opacity: 0;
    transform: translateX(-6px);
    transition:
      opacity 0.4s ease,
      transform 0.5s var(--ease),
      color 0.5s ease;
  }

  .card:hover .more,
  .card:focus-visible .more {
    opacity: 1;
    transform: none;
  }

  .card h3 {
    margin-top: 1rem;
    font-size: clamp(1.5rem, 2.4vw, 1.85rem);
  }

  .card p {
    color: var(--ink-soft);
    transition: color 0.5s ease;
    font-size: 0.98rem;
    display: -webkit-box;
    -webkit-line-clamp: 5;
    line-clamp: 5;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: auto 0 0;
    padding: 1rem 0 0;
    list-style: none;
  }

  .tag {
    transition: color 0.5s ease, border-color 0.5s ease;
  }

  .card:hover .period,
  .card:hover .more,
  .card:hover p,
  .card:hover .tag,
  .xp-ghost .period,
  .xp-ghost .more,
  .xp-ghost p,
  .xp-ghost .tag {
    color: rgba(251, 248, 243, 0.9);
  }

  .card:hover .tag,
  .xp-ghost .tag {
    border-color: rgba(251, 248, 243, 0.35);
  }

  .demo-hint {
    max-width: 44rem;
    margin-bottom: 1.25rem;
    color: var(--ink-soft);
    font-size: 0.95rem;
  }

  @media (prefers-reduced-motion: reduce) {
    .track {
      animation: none;
    }

    .viewport {
      overflow-x: auto;
      -webkit-mask-image: none;
      mask-image: none;
    }

    .dup {
      display: none;
    }
  }
</style>
