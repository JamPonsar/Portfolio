---
import { experience } from '../data/content';
---

<section id="experience" class="section experience">
  <div class="container">
    <span class="eyebrow" data-reveal>Work experience</span>
    <h2 class="section-title" data-reveal style="--delay: 100ms">
      Where I’ve <em>worked</em>.
    </h2>

    <ol class="timeline">
      {
        experience.map((job, i) => (
          <li data-reveal>
            <div
              class="job"
              data-index={i}
              role="button"
              tabindex="0"
              aria-label={`${job.role} at ${job.company} — view details`}
            >
              <div class="job-meta">
                <span class="period">{job.period}</span>
                <span class="type">{job.type}</span>
                <span class="more" aria-hidden="true">
                  Read more <span>→</span>
                </span>
              </div>

              <div class="job-body">
                <h3>
                  {job.role}
                  <span class="company">{job.company}</span>
                </h3>
                <ul class="points">
                  {job.points.map((point) => (
                    <li>{point}</li>
                  ))}
                </ul>
                <ul class="tags">
                  {job.tags.map((tag) => (
                    <li class="tag">{tag}</li>
                  ))}
                </ul>
              </div>
            </div>
          </li>
        ))
      }
    </ol>
  </div>

  <div class="xp-panel" role="dialog" aria-modal="true" aria-label="Experience details" hidden>
    <div class="xp-inner">
      <div class="xp-bar">
        <span class="xp-period"></span>
        <button type="button" class="xp-close" aria-label="Close experience details">
          <span>Close</span>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
            <path d="M5 5l14 14M19 5L5 19"></path>
          </svg>
        </button>
      </div>

      {
        experience.map((job, i) => (
          <div class="xp-detail" data-index={i} hidden>
            <h3>{job.title}</h3>
            <p class="xp-lead">
              <span class="detail-company">{job.company}</span> · {job.location} · {job.type}
            </p>

            <div class="xp-overview">
              {job.overview.map((para) => (
                <p>{para}</p>
              ))}
            </div>

            <h4>What I did</h4>
            <ul class="xp-list">
              {job.details.map((item) => (
                <li>{item}</li>
              ))}
            </ul>

            <h4>Skills &amp; tools</h4>
            <ul class="tags">
              {job.skills.map((skill) => (
                <li class="tag">{skill}</li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </div>
</section>

<script>
  import { createMorph } from '../scripts/morph';

  const section = document.getElementById('experience') as HTMLElement;
  const panel = section.querySelector<HTMLElement>('.xp-panel')!;
  const details = [...panel.querySelectorAll<HTMLElement>('.xp-detail')];

  const expander = createMorph({
    panel,
    // The row's hover card is its ::after, which reaches past the row's edges
    surface(card) {
      const after = getComputedStyle(card, '::after');
      return {
        top: parseFloat(after.top),
        right: parseFloat(after.right),
        bottom: parseFloat(after.bottom),
        left: parseFloat(after.left),
        radius: parseFloat(after.borderTopLeftRadius),
      };
    },
    onOpen(card) {
      details.forEach((d) => (d.hidden = d.dataset.index !== card.dataset.index));
      panel.querySelector('.xp-period')!.textContent = card.querySelector('.period')?.textContent ?? '';
    },
  });

  section.querySelectorAll<HTMLElement>('.job').forEach(expander.bind);
</script>

<style>
  .timeline {
    list-style: none;
    margin: 4rem 0 0;
    padding: 0;
  }

  .job {
    position: relative;
    display: grid;
    grid-template-columns: 220px 1fr;
    gap: 2.5rem;
    padding: 2.75rem 0;
    border-top: 1px solid var(--line);
    cursor: pointer;
    isolation: isolate;
  }

  li:last-child .job {
    border-bottom: 1px solid var(--line);
  }

  /* Accent line that draws across the top border on hover */
  .job::before {
    content: '';
    position: absolute;
    top: -1px;
    left: 0;
    width: 100%;
    height: 1px;
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.8s var(--ease);
  }

  /* Soft card behind the row on hover, so it reads as clickable */
  .job::after {
    content: '';
    position: absolute;
    inset: 0.75rem -1.25rem;
    z-index: -1;
    border-radius: 20px;
    background: var(--surface);
    opacity: 0;
    transition: opacity 0.4s ease;
  }

  .job:hover::before,
  .job:focus-visible::before {
    transform: scaleX(1);
  }

  .job:hover::after,
  .job:focus-visible::after {
    opacity: 1;
  }

  .job:focus-visible {
    outline: none;
  }

  .job-meta {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .period {
    font-weight: 600;
  }

  .type {
    font-size: 0.88rem;
    color: var(--ink-muted);
  }

  .more {
    margin-top: 0.75rem;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--accent);
    opacity: 0;
    transform: translateX(-6px);
    transition:
      opacity 0.4s ease,
      transform 0.5s var(--ease);
  }

  .more span {
    display: inline-block;
  }

  .job:hover .more,
  .job:focus-visible .more {
    opacity: 1;
    transform: none;
  }

  .job h3 {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.35rem 0.85rem;
    font-size: clamp(1.6rem, 3vw, 2.1rem);
  }

  .company {
    font-family: var(--font-body);
    font-size: 1rem;
    font-weight: 600;
    color: var(--accent);
  }

  .points {
    display: grid;
    gap: 0.6rem;
    margin: 1.25rem 0 0;
    padding: 0;
    list-style: none;
    color: var(--ink-soft);
  }

  .points li {
    position: relative;
    padding-left: 1.5rem;
  }

  .points li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.8em;
    width: 0.6rem;
    height: 1px;
    background: var(--accent);
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 1.5rem 0 0;
    padding: 0;
    list-style: none;
  }

  .xp-ghost::after {
    opacity: 1;
  }

  .xp-ghost {
    border-color: transparent;
  }

  /* The row itself is square, so the lift shadow goes on the rounded card instead */
  .xp-flying {
    box-shadow: none !important;
  }

  .xp-flying::after {
    box-shadow: 0 40px 80px -40px rgba(28, 26, 23, 0.35);
  }

  /* Same colour as the hover card, so the card can grow into the page */
  .xp-panel {
    background: var(--surface);
    box-shadow: none;
  }

  /* morph.ts animates the panel content itself */
  .xp-panel .xp-inner {
    opacity: 1;
    transform: none;
    transition: none;
  }

  .detail-company {
    font-weight: 700;
    color: var(--accent);
  }

  @media (max-width: 760px) {
    .job {
      grid-template-columns: 1fr;
      gap: 1rem;
    }

    .job::after {
      inset: 0.5rem -0.75rem;
    }

    /* No hover on touch screens, so always show the hint */
    .more {
      opacity: 1;
      transform: none;
      margin-top: 0.25rem;
    }
  }
</style>
